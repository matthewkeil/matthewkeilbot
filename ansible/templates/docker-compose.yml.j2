version: "3.8"

services:
  matthewkeilbot:
    image: ghcr.io/openclaw/openclaw:{{ openclaw_version }}
    container_name: matthewkeilbot
    restart: unless-stopped
    ports:
      - "{{ openclaw_port }}:18789"
    volumes:
      - /home/{{ openclaw_user }}/.openclaw:/home/node/.openclaw
      - matthewkeilbot-data:/data
    env_file:
      - .env
    environment:
      - NODE_ENV=production
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:18789/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

volumes:
  matthewkeilbot-data:
