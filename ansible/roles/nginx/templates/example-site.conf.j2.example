# Example Nginx vhost configuration
# {{ ansible_managed }}
#
# This file is documentation only — it is NOT loaded by nginx.
# To create a new vhost:
#   1. Copy this file to /etc/nginx/sites-available/your-site.conf
#   2. Edit the server_name, proxy_pass, and other settings
#   3. Create a symlink: ln -s /etc/nginx/sites-available/your-site.conf /etc/nginx/sites-enabled/
#   4. Test: nginx -t
#   5. Reload: systemctl reload nginx
#
# For Ansible-managed sites: create a role or playbook that templates
# the vhost config and creates the symlink.

