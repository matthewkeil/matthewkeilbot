# Copy this file to hosts.yml and update with your EC2 instance details
# The actual hosts.yml is gitignored for security

all:
  hosts:
    openclaw:
      ansible_host: YOUR_EC2_PUBLIC_IP
      ansible_user: ubuntu
      ansible_ssh_private_key_file: ~/.ssh/openclaw.pem

  vars:
    # AWS region where your instance is deployed
    aws_region: us-east-1

    # Domain name (if configured)
    # domain_name: openclaw.example.com
